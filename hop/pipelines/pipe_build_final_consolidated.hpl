    <copies>1</copies>
    <GUI>
      <xloc>150</xloc>
      <yloc>150</yloc>
    </GUI>
    <description>Popula a tabela dw.tb_final_consolidada_reclamacoes com os dados tratados e unidos</description>
    <partitioning>
