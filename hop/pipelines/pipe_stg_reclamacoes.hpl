<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>pipe_stg_reclamacoes</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Pipeline Hop para Carga dos 8 Trimestres de Reclamações em Staging</description>
    <extended_description/>
    <pipeline_version>1.0</pipeline_version>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
  </info>
  <order>
    <hop>
      <from>Text file input - Batch Reclamações CSV</from>
      <to>Filter rows - Ignore Empty Files</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Filter rows - Ignore Empty Files</from>
      <to>Replace in string - Format Decimal Comma</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Replace in string - Format Decimal Comma</from>
      <to>Select values - Type Mapping</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Select values - Type Mapping</from>
      <to>Table output - stg_reclamacoes</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Text file input - Batch Reclamações CSV</name>
    <type>TextFileInput2</type>
    <description>Leitura em Lote dos arquivos de Reclamações do BACEN (ANSI/ISO-8859-1)</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <accept_filenames>N</accept_filenames>
    <passing_through_fields>N</passing_through_fields>
    <accept_field/>
    <accept_transform_name/>
    <separator>;</separator>
    <enclosure>"</enclosure>
    <enclosure_breaks>N</enclosure_breaks>
    <escapechar/>
    <header>Y</header>
    <nr_headerlines>1</nr_headerlines>
    <footer>N</footer>
    <nr_footerlines>1</nr_footerlines>
    <line_wrapped>N</line_wrapped>
    <nr_wraps>1</nr_wraps>
    <layout_paged>N</layout_paged>
    <nr_lines_per_page>80</nr_lines_per_page>
    <nr_lines_doc_header>0</nr_lines_doc_header>
    <noempty>Y</noempty>
    <include>N</include>
    <include_field/>
    <rownum>N</rownum>
    <rownumByFile>N</rownumByFile>
    <rownum_field/>
    <format>mixed</format>
    <encoding>ISO-8859-1</encoding>
    <length>Characters</length>
    <add_to_result_filenames>Y</add_to_result_filenames>
    <file>
      <name>${PROJECT_HOME}/Dados/Reclamações/</name>
      <filemask>.*\.csv</filemask>
      <exclude_filemask>.*nao_ha_dados.*</exclude_filemask>
      <file_required>N</file_required>
      <include_subfolders>N</include_subfolders>
      <type>CSV</type>
      <compression>None</compression>
    </file>
    <filters>
    </filters>
    <fields>
      <field>
        <name>Ano</name>
        <type>Integer</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <nullif/>
        <ifnull/>
        <position>-1</position>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
        <repeat>N</repeat>
      </field>
      <field>
        <name>Trimestre</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <nullif/>
        <ifnull/>
        <position>-1</position>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
        <repeat>N</repeat>
      </field>
      <field>
        <name>Categoria</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <nullif/>
        <ifnull/>
        <position>-1</position>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
        <repeat>N</repeat>
      </field>
      <field>
        <name>Tipo</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <nullif/>
        <ifnull/>
        <position>-1</position>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
        <repeat>N</repeat>
      </field>
      <field>
        <name>CNPJ IF</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <nullif/>
        <ifnull/>
        <position>-1</position>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
        <repeat>N</repeat>
      </field>
      <field>
        <name>Instituição financeira</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <nullif/>
        <ifnull/>
        <position>-1</position>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
        <repeat>N</repeat>
      </field>
      <field>
        <name>Índice</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <nullif/>
        <ifnull/>
        <position>-1</position>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
        <repeat>N</repeat>
      </field>
      <field>
        <name>Quantidade de reclamações reguladas procedentes</name>
        <type>Integer</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <nullif/>
        <ifnull/>
        <position>-1</position>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
        <repeat>N</repeat>
      </field>
      <field>
        <name>Quantidade de reclamações reguladas - outras</name>
        <type>Integer</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <nullif/>
        <ifnull/>
        <position>-1</position>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
        <repeat>N</repeat>
      </field>
      <field>
        <name>Quantidade de reclamações não reguladas</name>
        <type>Integer</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <nullif/>
        <ifnull/>
        <position>-1</position>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
        <repeat>N</repeat>
      </field>
      <field>
        <name>Quantidade total de reclamações</name>
        <type>Integer</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <nullif/>
        <ifnull/>
        <position>-1</position>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
        <repeat>N</repeat>
      </field>
      <field>
        <name>Quantidade total de clientes - CCS e SCR</name>
        <type>Integer</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <nullif/>
        <ifnull/>
        <position>-1</position>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
        <repeat>N</repeat>
      </field>
      <field>
        <name>Quantidade de clientes - CCS</name>
        <type>Integer</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <nullif/>
        <ifnull/>
        <position>-1</position>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
        <repeat>N</repeat>
      </field>
      <field>
        <name>Quantidade de clientes - SCR</name>
        <type>Integer</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <nullif/>
        <ifnull/>
        <position>-1</position>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
        <repeat>N</repeat>
      </field>
    </fields>
    <limit>0</limit>
    <error_ignored>N</error_ignored>
    <skip_bad_files>N</skip_bad_files>
    <file_error_field/>
    <file_error_message_field/>
    <error_line_skipped>N</error_line_skipped>
    <error_count_field/>
    <error_fields_field/>
    <error_text_field/>
    <bad_line_files_destination_directory/>
    <bad_line_files_extension>warning</bad_line_files_extension>
    <error_line_files_destination_directory/>
    <error_line_files_extension>error</error_line_files_extension>
    <line_number_files_destination_directory/>
    <line_number_files_extension>line</line_number_files_extension>
    <date_format_lenient>Y</date_format_lenient>
    <date_format_locale>pt_BR</date_format_locale>
    <attributes/>
    <GUI>
      <xloc>150</xloc>
      <yloc>150</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Filter rows - Ignore Empty Files</name>
    <type>FilterRows</type>
    <description>Filtrar registros sem ano ou inválidos</description>
    <send_true_to>Replace in string - Format Decimal Comma</send_true_to>
    <send_false_to/>
    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue>Ano</leftvalue>
        <function>IS NOT NULL</function>
        <rightvalue/>
      </condition>
    </compare>
    <attributes/>
    <GUI>
      <xloc>450</xloc>
      <yloc>150</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Replace in string - Format Decimal Comma</name>
    <type>ReplaceString</type>
    <description>Remover ponto de milhar e substituir vírgula por ponto no índice de reclamações</description>
    <fields>
      <field>
        <in_stream_name>Índice</in_stream_name>
        <out_stream_name/>
        <use_regex>N</use_regex>
        <replace_string>.</replace_string>
        <replace_by_string/>
        <set_empty_string>N</set_empty_string>
        <replace_field_by_string/>
        <whole_word>N</whole_word>
        <case_sensitive>N</case_sensitive>
        <is_unicode>N</is_unicode>
      </field>
      <field>
        <in_stream_name>Índice</in_stream_name>
        <out_stream_name>indice_formatado</out_stream_name>
        <use_regex>N</use_regex>
        <replace_string>,</replace_string>
        <replace_by_string>.</replace_by_string>
        <set_empty_string>N</set_empty_string>
        <replace_field_by_string/>
        <whole_word>N</whole_word>
        <case_sensitive>N</case_sensitive>
        <is_unicode>N</is_unicode>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>750</xloc>
      <yloc>150</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Select values - Type Mapping</name>
    <type>SelectValues</type>
    <description>Mapear colunas e converter índice para Number</description>
    <fields>
      <field>
        <name>Ano</name>
        <rename>ano</rename>
      </field>
      <field>
        <name>Trimestre</name>
        <rename>trimestre</rename>
      </field>
      <field>
        <name>Categoria</name>
        <rename>categoria</rename>
      </field>
      <field>
        <name>Tipo</name>
        <rename>tipo</rename>
      </field>
      <field>
        <name>CNPJ IF</name>
        <rename>cnpj_if</rename>
      </field>
      <field>
        <name>Instituição financeira</name>
        <rename>instituicao_financeira</rename>
      </field>
      <field>
        <name>indice_formatado</name>
        <rename>indice_reclamacao</rename>
      </field>
      <field>
        <name>Quantidade de reclamações reguladas procedentes</name>
        <rename>qtd_reclamacoes_procedentes</rename>
      </field>
      <field>
        <name>Quantidade de reclamações reguladas - outras</name>
        <rename>qtd_reclamacoes_outras</rename>
      </field>
      <field>
        <name>Quantidade de reclamações não reguladas</name>
        <rename>qtd_reclamacoes_nao_reguladas</rename>
      </field>
      <field>
        <name>Quantidade total de reclamações</name>
        <rename>qtd_total_reclamacoes</rename>
      </field>
      <field>
        <name>Quantidade total de clientes - CCS e SCR</name>
        <rename>qtd_total_clientes_ccs_scr</rename>
      </field>
      <field>
        <name>Quantidade de clientes - CCS</name>
        <rename>qtd_clientes_ccs</rename>
      </field>
      <field>
        <name>Quantidade de clientes - SCR</name>
        <rename>qtd_clientes_scr</rename>
      </field>
      <select_unspecified>N</select_unspecified>
      <meta>
        <name>indice_reclamacao</name>
        <rename>indice_reclamacao</rename>
        <type>Number</type>
        <length>12</length>
        <precision>4</precision>
        <conversion_mask>#.#</conversion_mask>
        <decimal_symbol>.</decimal_symbol>
      </meta>
    </fields>
    <attributes/>
    <GUI>
      <xloc>1050</xloc>
      <yloc>150</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Table output - stg_reclamacoes</name>
    <type>TableOutput</type>
    <description>Carga no PostgreSQL na tabela staging.stg_reclamacoes</description>
    <connection>postgres_dw_conn</connection>
    <schema>staging</schema>
    <table>stg_reclamacoes</table>
    <commit>1000</commit>
    <truncate>Y</truncate>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>N</specify_fields>
    <attributes/>
    <GUI>
      <xloc>1350</xloc>
      <yloc>150</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>
